# Copy this file to .env (local) and add the same keys to Vercel's
# Project Settings -> Environment Variables for production.

# Postgres connection string. Works with Neon, Vercel Postgres, Supabase,
# or a local Postgres instance. Prisma uses this directly.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
